# ==============================================================================
# STRATA — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit your .env file containing real API keys to version control.
# ==============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Default User UUID for linking memories in Supabase Auth
# If omitted, STRATA will automatically detect the first user from auth.users
DEFAULT_USER_ID=

# Optional: OpenRouter API Key (for LLM routing / future expansion)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
